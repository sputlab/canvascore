# =====================================================================
#  CanvasCore — .gitignore
#  React editor (Vite, Zustand) + PHP compiler (SQLite) → static HTML
#  NB: version.json is the source of truth for the version → stays TRACKED
#      (updated by scripts/bump.mjs on every `npm run build`).
# =====================================================================

# ---------------------------------------------------------------------
#  Root = web root of the published site
#  rebuild_all.php / api.php write the static site into the folder
#  ABOVE canvascore-admin/, i.e. here: index.html, 404.html, sitemap.xml,
#  robots.txt, .htaccess, uploads/ and one folder per page slug or
#  collection item (arbitrary names). So the output is never committed,
#  everything at the root is ignored except what is listed below.
#  → If you add a new file/folder at the root, add it here.
# ---------------------------------------------------------------------
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE
!/SECURITY.md
!/CONTRIBUTING.md
!/docs/
!/canvascore-admin/
!/canvascore-frontend/
!/installers/
# A page or collection with the slug "docs" would be published in here
/docs/**/index.html
# Internal dev notes (phase notes, old release notes): kept locally, not published
/docs/dev/

# ---------------------------------------------------------------------
#  PHP backend: local data and deploy artifacts
# ---------------------------------------------------------------------
# "Legacy" data dir inside the web root (SQLite DB, settings.json, menu.json,
# forms.json, sessions/). The recommended one is ../../canvascore-data, already outside the repo.
/canvascore-admin/data/
# Written automatically by api.php / install.php (security headers and access rules)
/canvascore-admin/.htaccess
# Frontend build copied into canvascore-admin/ for deployment
/canvascore-admin/index.html
/canvascore-admin/menu-preview.html
/canvascore-admin/assets/
/canvascore-admin/favicon.svg
/canvascore-admin/icons.svg

# ---------------------------------------------------------------------
#  Node / Vite (editor frontend)
# ---------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# package-lock.json must be committed: do NOT ignore it

# ---------------------------------------------------------------------
#  PHP / Composer (if introduced in the future)
# ---------------------------------------------------------------------
vendor/
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache

# ---------------------------------------------------------------------
#  SQLite databases and journals (wherever they are)
# ---------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*-journal
*-wal
*-shm

# ---------------------------------------------------------------------
#  Environment variables and secrets
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
config.local.php

# ---------------------------------------------------------------------
#  Logs, cache, temporary files
# ---------------------------------------------------------------------
*.log
*.tmp
.cc_wtest_*

# ---------------------------------------------------------------------
#  Editor / IDE
# ---------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*~
.history/

# ---------------------------------------------------------------------
#  Operating system
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------
#  Release archives / backups (e.g. export_site)
# ---------------------------------------------------------------------
*.zip
*.tar.gz
*.bak
*.orig
