{
    "page": {
        "title": "Coming Soon",
        "slug": "coming-soon",
        "layout": "full",
        "seo_title": "Coming soon",
        "seo_description": "Something new is on its way."
    },
    "blocks": [
        {
            "type": "IMAGE",
            "content": {
                "src": "kit:assets/logo.svg",
                "alt": "Logo",
                "objectFit": "contain",
                "aspectRatio": "auto",
                "objectPosition": "center",
                "scale": 1
            },
            "styles": {
                "width": "120px",
                "margin": "40px auto 0"
            }
        },
        {
            "type": "SECTION",
            "styles": {
                "padding": "100px 20px",
                "backgroundColor": "#f8fafc",
                "width": "100%",
                "minHeight": "100vh"
            },
            "children": [
                {
                    "type": "CONTAINER",
                    "styles": {
                        "maxWidth": "640px",
                        "margin": "0 auto",
                        "width": "100%",
                        "textAlign": "center"
                    },
                    "children": [
                        {
                            "type": "TEXT",
                            "styles": {
                                "padding": "0 0 20px 0",
                                "width": "100%",
                                "textAlign": "center"
                            },
                            "content": {
                                "text": "<h1>Something new is coming</h1><p>We are putting the finishing touches on it. Leave your email and be the first to know.</p>"
                            }
                        },
                        {
                            "type": "COUNTDOWN",
                            "styles": {
                                "width": "100%",
                                "padding": "10px 0 30px 0"
                            },
                            "content": {
                                "datetime": "2030-01-01T09:00",
                                "utcOffset": "local",
                                "endAction": "message",
                                "endMessage": "We're live!",
                                "showSeconds": true,
                                "showDate": true,
                                "labelDays": "Days",
                                "labelHours": "Hours",
                                "labelMinutes": "Minutes",
                                "labelSeconds": "Seconds"
                            }
                        },
                        {
                            "type": "FORM",
                            "styles": {
                                "padding": "40px",
                                "backgroundColor": "#ffffff",
                                "borderRadius": "12px",
                                "width": "100%"
                            },
                            "content": {
                                "title": "<h3>Get notified at launch</h3>",
                                "email": "",
                                "btnText": "Notify me",
                                "successMsg": "Thanks! We'll let you know as soon as we launch.",
                                "fields": [
                                    {
                                        "label": "Email",
                                        "type": "email",
                                        "required": true
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
