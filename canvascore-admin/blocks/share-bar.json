{
  "type": "SHARE_BAR",
  "script": "share",
  "settings": {
    "title": {
      "type": "text",
      "default": "",
      "label": "Title (empty = none)"
    },
    "message": {
      "type": "text",
      "default": "",
      "label": "Message (empty = the page title)"
    },
    "networks": {
      "type": "choices",
      "options": [
        {
          "value": "facebook",
          "data": {
            "label": "Facebook",
            "svg": "",
            "badge": "f",
            "brand": "#1877f2",
            "link": "1",
            "aria": "Share on Facebook"
          },
          "label": "Facebook"
        },
        {
          "value": "x",
          "data": {
            "label": "X",
            "svg": "",
            "badge": "X",
            "brand": "#000000",
            "link": "1",
            "aria": "Share on X"
          },
          "label": "X"
        },
        {
          "value": "linkedin",
          "data": {
            "label": "LinkedIn",
            "svg": "",
            "badge": "in",
            "brand": "#0a66c2",
            "link": "1",
            "aria": "Share on LinkedIn"
          },
          "label": "LinkedIn"
        },
        {
          "value": "whatsapp",
          "data": {
            "label": "WhatsApp",
            "svg": "",
            "badge": "W",
            "brand": "#25d366",
            "link": "1",
            "aria": "Share on WhatsApp"
          },
          "label": "WhatsApp"
        },
        {
          "value": "telegram",
          "data": {
            "label": "Telegram",
            "svg": "",
            "badge": "T",
            "brand": "#229ed9",
            "link": "1",
            "aria": "Share on Telegram"
          },
          "label": "Telegram"
        },
        {
          "value": "email",
          "data": {
            "label": "Email",
            "svg": "<svg class=\"cc-share-icon\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/></svg>",
            "badge": "",
            "brand": "#475569",
            "link": "1",
            "aria": "Share by email"
          },
          "label": "Email"
        },
        {
          "value": "copy",
          "data": {
            "label": "Copy link",
            "svg": "<svg class=\"cc-share-icon\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2\"/><path d=\"M5 15V6a2 2 0 0 1 2-2h9\"/></svg>",
            "badge": "",
            "brand": "#475569",
            "link": "",
            "aria": "Copy link"
          },
          "label": "Copy link"
        },
        {
          "value": "print",
          "data": {
            "label": "Print",
            "svg": "<svg class=\"cc-share-icon\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9V3h12v6\"/><rect x=\"6\" y=\"14\" width=\"12\" height=\"7\"/><path d=\"M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"/></svg>",
            "badge": "",
            "brand": "#475569",
            "link": "",
            "aria": "Print"
          },
          "label": "Print"
        },
        {
          "value": "share",
          "data": {
            "label": "Share",
            "svg": "<svg class=\"cc-share-icon\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><line x1=\"8.6\" y1=\"13.5\" x2=\"15.4\" y2=\"17.5\"/><line x1=\"15.4\" y1=\"6.5\" x2=\"8.6\" y2=\"10.5\"/></svg>",
            "badge": "",
            "brand": "#475569",
            "link": "",
            "aria": "Share"
          },
          "label": "Share (phone share sheet)"
        }
      ]
    },
    "style": {
      "type": "text",
      "default": "",
      "label": "Buttons",
      "control": "select",
      "choices": [
        [
          "buttons",
          "Icon and name"
        ],
        [
          "icons",
          "Icon only"
        ]
      ]
    },
    "shape": {
      "type": "enum",
      "default": "pill",
      "options": [
        {
          "value": "pill",
          "data": {
            "radius": "999px"
          }
        },
        {
          "value": "square",
          "data": {
            "radius": "0"
          }
        },
        {
          "value": "rounded",
          "data": {
            "radius": "8px"
          }
        }
      ],
      "label": "Shape",
      "control": "select",
      "choices": [
        [
          "pill",
          "Pill"
        ],
        [
          "rounded",
          "Rounded"
        ],
        [
          "square",
          "Square"
        ]
      ]
    },
    "colors": {
      "type": "enum",
      "default": "brand",
      "options": [
        {
          "value": "brand",
          "label": "Network colors"
        },
        {
          "value": "mono",
          "label": "White with border"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "label": "Colors"
    },
    "size": {
      "type": "number",
      "parse": "int",
      "default": 40,
      "min": 28,
      "max": 64,
      "label": "Button height px"
    },
    "align": {
      "type": "enum",
      "default": "left",
      "options": [
        {
          "value": "left",
          "data": {
            "flex": "flex-start",
            "text": "left"
          },
          "label": "Left"
        },
        {
          "value": "center",
          "data": {
            "flex": "center",
            "text": "center"
          },
          "label": "Center"
        },
        {
          "value": "right",
          "data": {
            "flex": "flex-end",
            "text": "right"
          },
          "label": "Right"
        }
      ],
      "label": "Alignment"
    }
  },
  "template": [
    "<style>#{{_id}}[hidden],#{{_id}} [hidden]{display:none !important}#{{_id}} .cc-share-btn:hover{filter:brightness(.92)}#{{_id}} .cc-share-btn:focus-visible{outline:2px solid var(--brand-color, #3b82f6);outline-offset:2px}</style>",
    "<div id=\"{{_id}}\" class=\"cc-share{{_classes}}\" hidden data-msg=\"{{message}}\" style=\"{{{_style}}}\">\n",
    "{{^title=}}<div class=\"cc-share-title\" style=\"font-weight:700; font-size:15px; color:#0f172a; margin-bottom:10px; text-align:{{{opt.align.text}}};\">{{title}}</div>{{/title=}}",
    "<div class=\"cc-share-list\" style=\"display:flex; flex-wrap:wrap; gap:8px; justify-content:{{{opt.align.flex}}};\">",
    "{{#networks}}{{#link?}}<a class=\"cc-share-btn cc-share-{{value}}\" data-net=\"{{value}}\" href=\"#\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"{{{aria}}}\" style=\"display:inline-flex; align-items:center; justify-content:center; gap:8px; height:{{size}}px; min-width:{{size}}px; padding:0 {{#style=icons}}0{{/style=icons}}{{^style=icons}}16{{/style=icons}}px; box-sizing:border-box; border-radius:{{{opt.shape.radius}}}; font:600 14px/1 inherit; text-decoration:none; cursor:pointer; {{#colors=brand}}background:{{{brand}}}; color:#ffffff; border:1px solid {{{brand}}};{{/colors=brand}}{{#colors=dark}}background:#0f172a; color:#ffffff; border:1px solid #0f172a;{{/colors=dark}}{{#colors=mono}}background:#ffffff; color:#0f172a; border:1px solid #cbd5e1;{{/colors=mono}}\">{{#svg?}}{{{svg}}}{{/svg?}}{{^svg?}}<span class=\"cc-share-badge\" aria-hidden=\"true\" style=\"font-weight:800; font-size:14px; line-height:1;\">{{{badge}}}</span>{{/svg?}}{{^style=icons}}<span class=\"cc-share-label\">{{{label}}}</span>{{/style=icons}}</a>{{/link?}}",
    "{{^link?}}<button type=\"button\" class=\"cc-share-btn cc-share-{{value}}\" data-act=\"{{value}}\" aria-label=\"{{{aria}}}\" style=\"display:inline-flex; align-items:center; justify-content:center; gap:8px; height:{{size}}px; min-width:{{size}}px; padding:0 {{#style=icons}}0{{/style=icons}}{{^style=icons}}16{{/style=icons}}px; box-sizing:border-box; border-radius:{{{opt.shape.radius}}}; font:600 14px/1 inherit; text-decoration:none; cursor:pointer; {{#colors=brand}}background:{{{brand}}}; color:#ffffff; border:1px solid {{{brand}}};{{/colors=brand}}{{#colors=dark}}background:#0f172a; color:#ffffff; border:1px solid #0f172a;{{/colors=dark}}{{#colors=mono}}background:#ffffff; color:#0f172a; border:1px solid #cbd5e1;{{/colors=mono}}\">{{#svg?}}{{{svg}}}{{/svg?}}{{^svg?}}<span class=\"cc-share-badge\" aria-hidden=\"true\" style=\"font-weight:800; font-size:14px; line-height:1;\">{{{badge}}}</span>{{/svg?}}{{^style=icons}}<span class=\"cc-share-label\">{{{label}}}</span>{{/style=icons}}</button>{{/link?}}{{/networks}}",
    "</div>\n</div>\n{{{_script}}}"
  ],
  "panel": [
    {
      "title": "Share Bar",
      "icon": "Share2",
      "open": true,
      "keys": [
        "title",
        "message",
        "networks"
      ],
      "hint": "The links use the address of the page the visitor is on. Nothing is loaded from the networks until a visitor clicks. The bar appears once the page has loaded."
    },
    {
      "title": "Share Style",
      "icon": "Sliders",
      "keys": [
        "style",
        "shape",
        "colors",
        "size",
        "align"
      ]
    }
  ]
}
