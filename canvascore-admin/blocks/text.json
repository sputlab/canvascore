{
  "type": "TEXT",
  "settings": {
    "text": {
      "type": "richtext",
      "default": "",
      "inline": "full",
      "placeholder": "Type your text\u2026",
      "label": "Text",
      "control": "editor",
      "variant": "full",
      "minHeight": 140
    }
  },
  "template": [
    "<div id=\"{{_id}}\" class=\"cc-text{{_classes}}\"{{#_style?}} style=\"{{{_style}}}\"{{/_style?}}{{{_field.text}}}>\n",
    "{{{text}}}\n",
    "</div>\n"
  ],
  "panel": [
    {
      "title": "Text Content",
      "icon": "Layout",
      "open": true,
      "keys": [
        "text"
      ]
    }
  ]
}
