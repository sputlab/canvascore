{
  "type": "SCROLLYTELLING",
  "script": "story",
  "settings": {
    "steps": {
      "type": "list",
      "skipNonObjects": true,
      "max": 12,
      "item": {
        "image": {
          "type": "image",
          "default": "",
          "label": "Image shown with this step",
          "altKey": "alt"
        },
        "alt": {
          "type": "text",
          "default": "",
          "label": "Image alt text",
          "showIf": {
            "image": {
              "not": [
                ""
              ]
            }
          }
        },
        "title": {
          "type": "text",
          "default": "",
          "label": "Title"
        },
        "text": {
          "type": "text",
          "default": "",
          "transform": "br",
          "label": "Text",
          "control": "textarea",
          "rows": 3
        }
      },
      "itemTitle": "Step {n}",
      "itemTitleKey": "title",
      "itemKeys": [
        "title",
        "text",
        "image",
        "alt"
      ],
      "maxItems": 12,
      "addLabel": "+ Add step",
      "newItem": {
        "title": "New step",
        "text": "",
        "image": "",
        "alt": ""
      }
    },
    "side": {
      "type": "text",
      "default": "",
      "label": "Image side",
      "control": "select",
      "choices": [
        [
          "left",
          "Left"
        ],
        [
          "right",
          "Right"
        ]
      ]
    },
    "ratio": {
      "type": "enum",
      "default": "4 / 3",
      "options": [
        {
          "value": "4 / 3"
        },
        {
          "value": "1 / 1"
        },
        {
          "value": "3 / 4"
        },
        {
          "value": "16 / 9"
        },
        {
          "value": "3 / 2"
        }
      ],
      "label": "Image shape",
      "control": "select",
      "choices": [
        [
          "4 / 3",
          "4:3"
        ],
        [
          "3 / 2",
          "3:2"
        ],
        [
          "1 / 1",
          "1:1"
        ],
        [
          "16 / 9",
          "16:9"
        ],
        [
          "3 / 4",
          "3:4 (portrait)"
        ]
      ]
    },
    "top": {
      "type": "number",
      "parse": "int",
      "default": 80,
      "key": "stickyTop",
      "min": 0,
      "max": 300,
      "label": "Distance from the top while sticky px"
    },
    "stepHeight": {
      "type": "number",
      "parse": "int",
      "default": 70,
      "min": 40,
      "max": 120,
      "label": "Height of each step (% of the screen)"
    },
    "gap": {
      "type": "number",
      "parse": "int",
      "default": 48,
      "min": 0,
      "max": 120,
      "label": "Gap px"
    }
  },
  "template": [
    "<style>#{{_id}} .cc-story-img{opacity:0;transition:opacity .5s ease}#{{_id}}.cc-story-on .cc-story-step{opacity:.35;transition:opacity .4s ease}",
    "{{#steps}}#{{_id}}[data-active=\"{{@index}}\"] .cc-story-img[data-i=\"{{@index}}\"]{opacity:1}#{{_id}}.cc-story-on[data-active=\"{{@index}}\"] .cc-story-step[data-i=\"{{@index}}\"]{opacity:1}{{/steps}}",
    "@media(max-width:768px){#{{_id}} .cc-story-grid{grid-template-columns:1fr !important;gap:16px !important}#{{_id}} .cc-story-media{order:0 !important;top:0 !important;z-index:2}#{{_id}} .cc-story-frame{aspect-ratio:16 / 9 !important;max-height:36vh}#{{_id}} .cc-story-step{min-height:55vh !important}}",
    "@media(prefers-reduced-motion:reduce){#{{_id}} .cc-story-img,#{{_id}}.cc-story-on .cc-story-step{transition:none !important}}</style>",
    "<div id=\"{{_id}}\" class=\"cc-story cc-story-{{#side=right}}right{{/side=right}}{{^side=right}}left{{/side=right}}{{_classes}}\" data-active=\"0\" style=\"{{{_style}}}\">\n",
    "<div class=\"cc-story-grid\" style=\"display:grid; grid-template-columns:1fr 1fr; gap:{{gap}}px; align-items:start;\">",
    "<div class=\"cc-story-media\" style=\"position:sticky; top:{{top}}px; align-self:start;{{#side=right}} order:2;{{/side=right}}\"><div class=\"cc-story-frame\" style=\"position:relative; aspect-ratio:{{ratio}}; border-radius:16px; overflow:hidden; background:#e2e8f0;\">",
    "{{#steps}}{{^image=}}<img class=\"cc-story-img\" data-i=\"{{@index}}\" src=\"{{image}}\" alt=\"{{alt}}\" loading=\"lazy\" style=\"position:absolute; inset:0; width:100%; height:100%; object-fit:cover;\">{{/image=}}",
    "{{#image=}}<div class=\"cc-story-img cc-story-ph\" data-i=\"{{@index}}\" aria-hidden=\"true\" style=\"position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:56px; font-weight:800; color:#94a3b8;\">{{@number}}</div>{{/image=}}{{/steps}}</div></div>",
    "<ol class=\"cc-story-steps\" style=\"list-style:none; margin:0; padding:0;\">{{#steps}}<li class=\"cc-story-step\" data-i=\"{{@index}}\" style=\"min-height:{{stepHeight}}vh; display:flex; flex-direction:column; justify-content:center; padding:24px 0;\">",
    "{{^title=}}<h3 class=\"cc-story-title\" style=\"margin:0 0 10px 0; font-size:26px; line-height:1.25;\">{{title}}</h3>{{/title=}}",
    "{{^text=}}<p class=\"cc-story-text\" style=\"margin:0; font-size:16px; line-height:1.7; color:#475569;\">{{{text}}}</p>{{/text=}}</li>{{/steps}}</ol>",
    "</div>\n</div>\n{{#steps?}}{{{_script}}}{{/steps?}}"
  ],
  "panel": [
    {
      "title": "Story Steps",
      "icon": "ScrollText",
      "open": true,
      "keys": [
        "steps"
      ],
      "hint": "The image stays in view while the visitor scrolls, and changes with the step in the middle of the screen. Up to 12 steps. In the editor the first image is shown."
    },
    {
      "title": "Story Layout",
      "icon": "Sliders",
      "keys": [
        "side",
        "ratio",
        "top",
        "stepHeight",
        "gap"
      ]
    }
  ]
}
