{
  "type": "CASE_STUDY",
  "settings": {
    "accent": {
      "type": "color",
      "default": "var(--brand-color, #3b82f6)"
    },
    "layout": {
      "type": "text",
      "default": ""
    },
    "image": {
      "type": "image",
      "default": ""
    },
    "logo": {
      "type": "image",
      "default": ""
    },
    "alt": {
      "type": "text",
      "default": ""
    },
    "client": {
      "type": "text",
      "default": ""
    },
    "metric": {
      "type": "text",
      "default": ""
    },
    "metricLabel": {
      "type": "text",
      "default": ""
    },
    "title": {
      "type": "text",
      "default": ""
    },
    "text": {
      "type": "text",
      "default": ""
    },
    "quote": {
      "type": "text",
      "default": ""
    },
    "quoteAuthor": {
      "type": "text",
      "default": ""
    },
    "linkText": {
      "type": "text",
      "default": ""
    },
    "linkUrl": {
      "type": "text",
      "default": "",
      "transform": "blockUrl"
    },
    "hasClient": {
      "type": "flag",
      "any": true,
      "when": {
        "logo": {
          "not": [
            ""
          ]
        },
        "client": {
          "not": [
            ""
          ]
        }
      }
    }
  },
  "template": [
    "<style>@media(max-width:768px){#{{_id}} .cc-case-card{flex-direction:column !important}#{{_id}} .cc-case-media{flex:0 0 220px !important}}</style>",
    "<article id=\"{{_id}}\" class=\"cc-case{{_classes}}\" style=\"{{{_style}}}\">\n",
    "<div class=\"cc-case-card\" style=\"display:flex; flex-direction:{{#layout=vertical}}column{{/layout=vertical}}{{^layout=vertical}}row{{/layout=vertical}}; background:#fff; border:1px solid #e2e8f0; border-radius:16px; overflow:hidden; box-shadow:0 4px 18px rgba(15,23,42,0.06);\">",
    "{{^image=}}<div class=\"cc-case-media\" style=\"flex:{{#layout=vertical}}0 0 240px{{/layout=vertical}}{{^layout=vertical}}0 0 42%{{/layout=vertical}}; position:relative; min-height:220px; background:#e2e8f0;\"><img src=\"{{image}}\" alt=\"{{alt}}\" loading=\"lazy\" style=\"position:absolute; inset:0; width:100%; height:100%; object-fit:cover;\"></div>{{/image=}}",
    "<div class=\"cc-case-body\" style=\"flex:1; min-width:0; padding:32px; display:flex; flex-direction:column; gap:14px;\">",
    "{{#hasClient}}<div class=\"cc-case-client\" style=\"display:flex; align-items:center; gap:10px; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:#64748b;\">{{^logo=}}<img src=\"{{logo}}\" alt=\"\" loading=\"lazy\" style=\"height:28px; width:auto; display:block;\">{{/logo=}}{{client}}</div>{{/hasClient}}",
    "{{^metric=}}<div class=\"cc-case-metric\"><div class=\"cc-case-metric-value\" style=\"font-size:44px; font-weight:800; line-height:1; color:{{accent}};\">{{metric}}</div>{{^metricLabel=}}<div class=\"cc-case-metric-label\" style=\"margin-top:4px; font-size:14px; color:#475569;\">{{metricLabel}}</div>{{/metricLabel=}}</div>{{/metric=}}",
    "{{^title=}}<h3 class=\"cc-case-title\" style=\"margin:0; font-size:22px; line-height:1.3; color:#0f172a;\">{{title}}</h3>{{/title=}}",
    "{{^text=}}<p class=\"cc-case-text\" style=\"margin:0; font-size:15px; line-height:1.6; color:#475569;\">{{text}}</p>{{/text=}}",
    "{{^quote=}}<blockquote class=\"cc-case-quote\" style=\"margin:0; padding-left:14px; border-left:3px solid {{accent}}; font-style:italic; color:#334155; font-size:15px; line-height:1.55;\">{{quote}}{{^quoteAuthor=}}<cite class=\"cc-case-quote-author\" style=\"display:block; margin-top:6px; font-style:normal; font-weight:600; font-size:13px; color:#64748b;\">&mdash; {{quoteAuthor}}</cite>{{/quoteAuthor=}}</blockquote>{{/quote=}}",
    "{{^linkText=}}<a class=\"cc-case-link\" href=\"{{linkUrl}}\" style=\"margin-top:auto; color:{{accent}}; font-weight:700; text-decoration:none;\">{{linkText}} &rarr;</a>{{/linkText=}}",
    "</div></div>\n</article>\n"
  ]
}
