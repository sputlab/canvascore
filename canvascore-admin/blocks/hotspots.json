{
  "type": "HOTSPOTS",
  "script": "hotspots",
  "settings": {
    "pins": {
      "type": "list",
      "skipNonObjects": true,
      "max": 20,
      "item": {
        "x": {
          "type": "number",
          "default": 50,
          "min": 0,
          "max": 100
        },
        "y": {
          "type": "number",
          "default": 50,
          "min": 0,
          "max": 100
        },
        "xText": {
          "type": "number",
          "key": "x",
          "default": 50,
          "min": 0,
          "max": 100,
          "transform": "fmtNum",
          "decimals": 1
        },
        "yText": {
          "type": "number",
          "key": "y",
          "default": 50,
          "min": 0,
          "max": 100,
          "transform": "fmtNum",
          "decimals": 1
        },
        "above": {
          "type": "flag",
          "when": {
            "y": {
              "gt": 55
            }
          }
        },
        "left": {
          "type": "flag",
          "when": {
            "x": {
              "lt": 25
            }
          }
        },
        "right": {
          "type": "flag",
          "when": {
            "x": {
              "gt": 75
            }
          }
        },
        "title": {
          "type": "text",
          "default": ""
        },
        "text": {
          "type": "text",
          "default": "",
          "transform": "br"
        },
        "linkText": {
          "type": "text",
          "default": ""
        },
        "href": {
          "type": "text",
          "default": "",
          "transform": "blockUrl"
        }
      }
    },
    "image": {
      "type": "image",
      "default": "",
      "label": "Image",
      "altKey": "alt"
    },
    "alt": {
      "type": "text",
      "default": "",
      "label": "Image alt text"
    },
    "ratio": {
      "type": "enum",
      "default": "16 / 9",
      "options": [
        {
          "value": "16 / 9"
        },
        {
          "value": "4 / 3"
        },
        {
          "value": "3 / 2"
        },
        {
          "value": "1 / 1"
        },
        {
          "value": "21 / 9"
        }
      ],
      "label": "Empty image shape",
      "control": "select",
      "showIf": {
        "image": false
      },
      "choices": [
        [
          "16 / 9",
          "16:9"
        ],
        [
          "4 / 3",
          "4:3"
        ],
        [
          "3 / 2",
          "3:2"
        ],
        [
          "1 / 1",
          "1:1"
        ],
        [
          "21 / 9",
          "21:9"
        ]
      ]
    },
    "pinColor": {
      "type": "color",
      "default": "#3b82f6",
      "label": "Pin color"
    },
    "pinTextColor": {
      "type": "color",
      "default": "#ffffff",
      "label": "Pin number color"
    },
    "radius": {
      "type": "number",
      "parse": "int",
      "default": 12,
      "min": 0,
      "max": 40,
      "label": "Corner radius px"
    },
    "pulse": {
      "type": "bool",
      "default": true,
      "label": "Pulsing ring (off for visitors who prefer reduced motion)"
    }
  },
  "template": [
    "<style>#{{_id}} .cc-hs-pop{opacity:0;visibility:hidden;transition:opacity .15s ease}#{{_id}} .cc-hs-pin:hover,#{{_id}} .cc-hs-pin:focus-within,#{{_id}} .cc-hs-pin.is-open{z-index:3}",
    "#{{_id}} .cc-hs-pin:hover .cc-hs-pop,#{{_id}} .cc-hs-pin:focus-within .cc-hs-pop,#{{_id}} .cc-hs-pin.is-open .cc-hs-pop{opacity:1;visibility:visible}",
    "#{{_id}} .cc-hs-below .cc-hs-pop{top:calc(100% + 10px)}#{{_id}} .cc-hs-above .cc-hs-pop{bottom:calc(100% + 10px)}",
    "#{{_id}} .cc-hs-center .cc-hs-pop{left:50%;transform:translateX(-50%)}#{{_id}} .cc-hs-left .cc-hs-pop{left:0}#{{_id}} .cc-hs-right .cc-hs-pop{right:0}",
    "@keyframes ccHsRing_{{_id}}{0%{transform:scale(1);opacity:.5}100%{transform:scale(2.3);opacity:0}}#{{_id}} .cc-hs-ring{animation:ccHsRing_{{_id}} 2s ease-out infinite}",
    "@media(prefers-reduced-motion:reduce){#{{_id}} .cc-hs-ring{animation:none;display:none}#{{_id}} .cc-hs-pop{transition:none}}</style>",
    "<div id=\"{{_id}}\" class=\"cc-hotspots{{_classes}}\" style=\"{{{_style}}}\">\n<div class=\"cc-hs-stage\" style=\"position:relative;\">",
    "{{^image=}}<img class=\"cc-hs-img\" src=\"{{image}}\" alt=\"{{alt}}\" loading=\"lazy\" style=\"display:block; width:100%; height:auto; border-radius:{{radius}}px;\">{{/image=}}",
    "{{#image=}}<div class=\"cc-hs-img cc-hs-ph\" aria-hidden=\"true\" style=\"aspect-ratio:{{ratio}}; background:#e2e8f0; border-radius:{{radius}}px;\"></div>{{/image=}}",
    "{{#pins}}<div class=\"cc-hs-pin cc-hs-{{#above}}above{{/above}}{{^above}}below{{/above}} cc-hs-{{#left}}left{{/left}}{{^left}}{{#right}}right{{/right}}{{^right}}center{{/right}}{{/left}}\" style=\"position:absolute; left:{{xText}}%; top:{{yText}}%; transform:translate(-50%, -50%);\">",
    "<button type=\"button\" class=\"cc-hs-btn\" aria-describedby=\"{{_id}}-p{{@index}}\" aria-label=\"{{^title=}}{{title}}{{/title=}}{{#title=}}Hotspot {{@number}}{{/title=}}\" style=\"position:relative; width:30px; height:30px; padding:0; border-radius:50%; border:2px solid #fff; background:{{pinColor}}; color:{{pinTextColor}}; font:700 13px/1 inherit; cursor:pointer; box-shadow:0 2px 8px rgba(15,23,42,0.35);\">",
    "{{#pulse}}<span class=\"cc-hs-ring\" aria-hidden=\"true\" style=\"position:absolute; inset:-2px; border-radius:50%; background:{{pinColor}}; pointer-events:none;\"></span>{{/pulse}}<span class=\"cc-hs-num\" style=\"position:relative;\">{{@number}}</span></button>",
    "<div class=\"cc-hs-pop\" id=\"{{_id}}-p{{@index}}\" role=\"tooltip\" style=\"position:absolute; width:240px; max-width:70vw; padding:14px 16px; background:#fff; color:#0f172a; border-radius:10px; box-shadow:0 12px 32px rgba(15,23,42,0.22); font-size:14px; line-height:1.5; text-align:left;\">",
    "{{^title=}}<strong class=\"cc-hs-title\" style=\"display:block; margin-bottom:4px;\">{{title}}</strong>{{/title=}}",
    "{{^text=}}<span class=\"cc-hs-text\" style=\"display:block; color:#475569;\">{{{text}}}</span>{{/text=}}",
    "{{^linkText=}}<a class=\"cc-hs-link\" href=\"{{href}}\" style=\"display:inline-block; margin-top:8px; font-weight:700; color:var(--brand-color, #3b82f6); text-decoration:none;\">{{linkText}} &rarr;</a>{{/linkText=}}",
    "</div></div>{{/pins}}</div>\n</div>\n{{#pins?}}{{{_script}}}{{/pins?}}"
  ],
  "panel": [
    {
      "title": "Hotspot Image",
      "icon": "Image",
      "open": true,
      "keys": [
        "image",
        "alt",
        "ratio"
      ]
    },
    {
      "title": "Hotspot Pins",
      "icon": "MapPinned",
      "open": true,
      "widget": "hotspotPins"
    },
    {
      "title": "Hotspot Style",
      "icon": "Sliders",
      "keys": [
        "pinColor",
        "pinTextColor",
        "pulse",
        "radius"
      ],
      "hint": "The text opens on hover, keyboard focus, or a tap or click."
    }
  ]
}
