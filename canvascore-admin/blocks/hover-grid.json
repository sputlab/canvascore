{
  "type": "HOVER_GRID",
  "settings": {
    "items": {
      "type": "list",
      "skipNonObjects": true,
      "item": {
        "image": {
          "type": "image",
          "default": ""
        },
        "alt": {
          "type": "text",
          "default": ""
        },
        "href": {
          "type": "text",
          "default": "",
          "trim": true
        },
        "link": {
          "type": "text",
          "default": "",
          "key": "href",
          "transform": "blockUrl"
        },
        "title": {
          "type": "text",
          "default": ""
        },
        "text": {
          "type": "text",
          "default": ""
        }
      }
    },
    "columns": {
      "type": "number",
      "parse": "int",
      "default": 3,
      "min": 1,
      "max": 4
    },
    "gap": {
      "type": "number",
      "parse": "int",
      "default": 16,
      "min": 0,
      "max": 48
    },
    "radius": {
      "type": "number",
      "parse": "int",
      "default": 12,
      "min": 0,
      "max": 40
    },
    "aspectRatio": {
      "type": "enum",
      "default": "4 / 3",
      "options": [
        {
          "value": "1 / 1"
        },
        {
          "value": "4 / 3"
        },
        {
          "value": "3 / 2"
        },
        {
          "value": "16 / 9"
        },
        {
          "value": "3 / 4"
        }
      ]
    },
    "effect": {
      "type": "enum",
      "default": "slide",
      "options": [
        {
          "value": "slide"
        },
        {
          "value": "fade"
        }
      ]
    },
    "overlay": {
      "type": "color",
      "default": "rgba(15,23,42,0.72)"
    },
    "mobileColumns": {
      "type": "calc",
      "of": "columns",
      "max": 2
    }
  },
  "template": [
    "<style>#{{_id}} .cc-hg-reveal{transition:opacity .3s ease, transform .3s ease}#{{_id}}.cc-hg-fade .cc-hg-reveal{opacity:0}#{{_id}}.cc-hg-slide .cc-hg-reveal{opacity:0;transform:translateY(16px)}",
    "#{{_id}} .cc-hg-item:hover .cc-hg-reveal,#{{_id}} .cc-hg-item:focus-within .cc-hg-reveal,#{{_id}} .cc-hg-item:focus .cc-hg-reveal{opacity:1;transform:none}",
    "#{{_id}} .cc-hg-img{transition:transform .5s ease}#{{_id}} .cc-hg-item:hover .cc-hg-img{transform:scale(1.05)}",
    "@media(hover:none){#{{_id}} .cc-hg-reveal{opacity:1 !important;transform:none !important}}",
    "@media(prefers-reduced-motion:reduce){#{{_id}} .cc-hg-reveal,#{{_id}} .cc-hg-img{transition:none !important}#{{_id}} .cc-hg-item:hover .cc-hg-img{transform:none}}",
    "@media(max-width:768px){#{{_id}} .cc-hg-grid{grid-template-columns:repeat({{mobileColumns}}, 1fr) !important}}@media(max-width:480px){#{{_id}} .cc-hg-grid{grid-template-columns:1fr !important}}</style>",
    "<div id=\"{{_id}}\" class=\"cc-hover-grid cc-hg-{{effect}}{{_classes}}\" style=\"{{{_style}}}\">\n",
    "<div class=\"cc-hg-grid\" style=\"display:grid; grid-template-columns:repeat({{columns}}, 1fr); gap:{{gap}}px;\">",
    "{{#items}}<{{#href=}}div{{/href=}}{{^href=}}a{{/href=}} class=\"cc-hg-item\"{{^href=}} href=\"{{link}}\"{{/href=}} style=\"position:relative; display:block; overflow:hidden; border-radius:{{radius}}px; aspect-ratio:{{aspectRatio}}; background:#e2e8f0; color:#fff; text-decoration:none;\">",
    "{{^image=}}<img class=\"cc-hg-img\" src=\"{{image}}\" alt=\"{{alt}}\" loading=\"lazy\" style=\"position:absolute; inset:0; width:100%; height:100%; object-fit:cover;\">{{/image=}}",
    "<div class=\"cc-hg-reveal\" style=\"position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:20px; background:{{overlay}};\">",
    "{{^title=}}<h3 class=\"cc-hg-title\" style=\"margin:0; font-size:18px; line-height:1.3; color:#fff;\">{{title}}</h3>{{/title=}}",
    "{{^text=}}<p class=\"cc-hg-text\" style=\"margin:6px 0 0 0; font-size:14px; line-height:1.5; color:rgba(255,255,255,0.88);\">{{text}}</p>{{/text=}}",
    "</div></{{#href=}}div{{/href=}}{{^href=}}a{{/href=}}>{{/items}}</div>\n</div>\n"
  ]
}
