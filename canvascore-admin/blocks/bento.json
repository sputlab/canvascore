{
  "type": "BENTO",
  "settings": {
    "tiles": {
      "type": "list",
      "skipNonObjects": true,
      "item": {
        "size": {
          "type": "enum",
          "default": "normal",
          "options": [
            {
              "value": "normal",
              "data": {
                "cols": "1",
                "rows": "1"
              }
            },
            {
              "value": "wide",
              "data": {
                "cols": "2",
                "rows": "1"
              }
            },
            {
              "value": "tall",
              "data": {
                "cols": "1",
                "rows": "2"
              }
            },
            {
              "value": "large",
              "data": {
                "cols": "2",
                "rows": "2"
              }
            }
          ]
        },
        "image": {
          "type": "image",
          "default": ""
        },
        "alt": {
          "type": "text",
          "default": ""
        },
        "bg": {
          "type": "color",
          "default": "#f1f5f9"
        },
        "color": {
          "type": "color",
          "default": ""
        },
        "href": {
          "type": "text",
          "default": "",
          "trim": true
        },
        "link": {
          "type": "text",
          "default": "",
          "key": "href",
          "transform": "blockUrl"
        },
        "title": {
          "type": "text",
          "default": ""
        },
        "text": {
          "type": "text",
          "default": ""
        },
        "icon": {
          "type": "text",
          "default": ""
        }
      }
    },
    "columns": {
      "type": "number",
      "parse": "int",
      "default": 3,
      "min": 2,
      "max": 4
    },
    "rowHeight": {
      "type": "number",
      "parse": "int",
      "default": 180,
      "min": 100,
      "max": 400
    },
    "gap": {
      "type": "number",
      "parse": "int",
      "default": 16,
      "min": 0,
      "max": 48
    },
    "hover": {
      "type": "enum",
      "default": "lift",
      "options": [
        {
          "value": "lift"
        },
        {
          "value": "zoom"
        },
        {
          "value": "none"
        }
      ]
    }
  },
  "template": [
    "<style>#{{_id}} .cc-bento-tile{transition:transform .25s ease, box-shadow .25s ease}#{{_id}} .cc-bento-img{transition:transform .5s ease}",
    "#{{_id}}.cc-bento-hover-lift .cc-bento-tile:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(15,23,42,0.16)}#{{_id}}.cc-bento-hover-zoom .cc-bento-tile:hover .cc-bento-img{transform:scale(1.06)}",
    "@media(max-width:768px){#{{_id}} .cc-bento-grid{grid-template-columns:repeat(2, 1fr) !important}}@media(max-width:480px){#{{_id}} .cc-bento-grid{grid-template-columns:1fr !important}#{{_id}} .cc-bento-tile{grid-column:auto !important;grid-row:auto !important}}",
    "@media(prefers-reduced-motion:reduce){#{{_id}} .cc-bento-tile,#{{_id}} .cc-bento-img{transition:none !important;transform:none !important}}</style>",
    "<div id=\"{{_id}}\" class=\"cc-bento cc-bento-hover-{{hover}}{{_classes}}\" style=\"{{{_style}}}\">\n",
    "<div class=\"cc-bento-grid\" style=\"display:grid; grid-template-columns:repeat({{columns}}, 1fr); grid-auto-rows:minmax({{rowHeight}}px, auto); gap:{{gap}}px;\">",
    "{{#tiles}}<{{#href=}}div{{/href=}}{{^href=}}a{{/href=}} class=\"cc-bento-tile cc-bento-{{size}}\"{{^href=}} href=\"{{link}}\"{{/href=}} style=\"grid-column:span {{{opt.size.cols}}}; grid-row:span {{{opt.size.rows}}}; position:relative; overflow:hidden; border-radius:16px; background:{{bg}}; color:{{#color?}}{{color}}{{/color?}}{{^color?}}{{^image=}}#ffffff{{/image=}}{{#image=}}#0f172a{{/image=}}{{/color?}}; padding:24px; display:flex; flex-direction:column; justify-content:flex-end; text-decoration:none; min-width:0;\">",
    "{{^image=}}<img class=\"cc-bento-img\" src=\"{{image}}\" alt=\"{{alt}}\" loading=\"lazy\" style=\"position:absolute; inset:0; width:100%; height:100%; object-fit:cover;\"><div class=\"cc-bento-shade\" aria-hidden=\"true\" style=\"position:absolute; inset:0; background:linear-gradient(to top, rgba(15,23,42,0.78), rgba(15,23,42,0) 65%);\"></div>{{/image=}}",
    "<div class=\"cc-bento-body\" style=\"position:relative;\">",
    "{{^icon=}}<div class=\"cc-bento-icon\" aria-hidden=\"true\" style=\"font-size:28px; line-height:1; margin-bottom:10px;\">{{icon}}</div>{{/icon=}}",
    "{{^title=}}<h3 class=\"cc-bento-title\" style=\"margin:0; font-size:20px; line-height:1.25; color:inherit;\">{{title}}</h3>{{/title=}}",
    "{{^text=}}<p class=\"cc-bento-text\" style=\"margin:6px 0 0 0; font-size:14px; line-height:1.5; opacity:0.85;\">{{text}}</p>{{/text=}}",
    "</div></{{#href=}}div{{/href=}}{{^href=}}a{{/href=}}>{{/tiles}}</div>\n</div>\n"
  ]
}
