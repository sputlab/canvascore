{
  "type": "BUSINESS",
  "script": "business",
  "settings": {
    "businessType": {
      "type": "enum",
      "default": "LocalBusiness",
      "options": [
        {
          "value": "LocalBusiness"
        },
        {
          "value": "Restaurant"
        },
        {
          "value": "Store"
        },
        {
          "value": "CafeOrCoffeeShop"
        },
        {
          "value": "Dentist"
        },
        {
          "value": "HairSalon"
        },
        {
          "value": "HealthAndBeautyBusiness"
        },
        {
          "value": "ProfessionalService"
        },
        {
          "value": "LegalService"
        },
        {
          "value": "AutoRepair"
        },
        {
          "value": "Hotel"
        },
        {
          "value": "Organization"
        }
      ]
    },
    "name": {
      "type": "text",
      "default": "",
      "trim": true
    },
    "address": {
      "type": "text",
      "default": "",
      "transform": "br"
    },
    "addressText": {
      "type": "text",
      "default": "",
      "key": "address"
    },
    "maps": {
      "type": "text",
      "default": "",
      "key": "address",
      "transform": "mapsUrl"
    },
    "phone": {
      "type": "text",
      "default": "",
      "trim": true
    },
    "tel": {
      "type": "text",
      "default": "",
      "key": "phone",
      "trim": true,
      "transform": "telDigits"
    },
    "email": {
      "type": "text",
      "default": "",
      "trim": true
    },
    "emailHref": {
      "type": "text",
      "default": "",
      "key": "email",
      "trim": true,
      "transform": "mailto"
    },
    "web": {
      "type": "text",
      "default": "",
      "key": "website",
      "transform": "extUrl"
    },
    "webShown": {
      "type": "text",
      "default": "",
      "key": "website",
      "transform": [
        "extUrl",
        "stripScheme"
      ]
    },
    "mapsLink": {
      "type": "bool",
      "default": true
    },
    "directionsLabel": {
      "type": "text",
      "default": "Get directions"
    },
    "closedLabel": {
      "type": "text",
      "default": "Closed"
    },
    "hoursTitle": {
      "type": "text",
      "default": "Opening hours"
    },
    "note": {
      "type": "text",
      "default": ""
    },
    "jsonLd": {
      "type": "bool",
      "default": true
    },
    "hours": {
      "type": "list",
      "max": 7,
      "defaultsByIndex": {
        "day": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ]
      },
      "item": {
        "day": {
          "type": "text",
          "default": ""
        },
        "closed": {
          "type": "bool",
          "default": false
        },
        "start": {
          "type": "text",
          "default": "",
          "key": "open",
          "trim": true,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "end": {
          "type": "text",
          "default": "",
          "key": "close",
          "trim": true,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "isOpen": {
          "type": "flag",
          "when": {
            "closed": false,
            "start": {
              "not": [
                ""
              ]
            },
            "end": {
              "not": [
                ""
              ]
            }
          }
        }
      }
    },
    "hasHours": {
      "type": "flag",
      "any": true,
      "when": {
        "hours": true,
        "note": {
          "not": [
            ""
          ]
        }
      }
    }
  },
  "template": [
    "<style>@media(max-width:768px){#{{_id}}{grid-template-columns:1fr !important}}</style>",
    "<div id=\"{{_id}}\" class=\"cc-business{{_classes}}\" style=\"{{{_style}}} display:grid; grid-template-columns:repeat(2, 1fr); gap:32px;\">\n<div class=\"cc-biz-contact\">",
    "{{^name=}}<h3 class=\"cc-biz-name\" style=\"margin:0 0 10px 0; font-size:20px;\">{{name}}</h3>{{/name=}}",
    "{{^address=}}<address class=\"cc-biz-address\" style=\"font-style:normal; line-height:1.6; margin:0 0 10px 0;\">{{{address}}}</address>{{/address=}}",
    "{{^tel=}}<div class=\"cc-biz-line\" style=\"margin-bottom:4px;\"><a class=\"cc-biz-link\" href=\"tel:{{tel}}\" style=\"color:inherit;\">{{phone}}</a></div>{{/tel=}}",
    "{{^emailHref=}}<div class=\"cc-biz-line\" style=\"margin-bottom:4px;\"><a class=\"cc-biz-link\" href=\"{{emailHref}}\" style=\"color:inherit;\">{{email}}</a></div>{{/emailHref=}}",
    "{{^web=}}<div class=\"cc-biz-line\" style=\"margin-bottom:4px;\"><a class=\"cc-biz-link\" href=\"{{web}}\" rel=\"noopener\" style=\"color:inherit;\">{{webShown}}</a></div>{{/web=}}",
    "{{^address=}}{{#mapsLink}}<a class=\"cc-biz-directions\" rel=\"noopener\" href=\"{{maps}}\" style=\"display:inline-block; margin-top:12px; padding:9px 16px; border-radius:8px; background:var(--brand-color, #3b82f6); color:#fff; text-decoration:none; font-weight:600; font-size:14px;\">{{directionsLabel}}</a>{{/mapsLink}}{{/address=}}",
    "</div>\n",
    "{{#hasHours}}<div class=\"cc-biz-hours\"><h3 class=\"cc-biz-hours-title\" style=\"margin:0 0 10px 0; font-size:20px;\">{{hoursTitle}}</h3>",
    "{{#hours?}}<table class=\"cc-biz-table\" style=\"width:100%; border-collapse:collapse; font-size:15px;\"><tbody>{{#hours}}<tr style=\"border-bottom:1px solid #e2e8f0;\"><th scope=\"row\" style=\"text-align:left; padding:8px 0; font-weight:600;\">{{day}}</th><td style=\"text-align:right; padding:8px 0;\">{{#isOpen}}{{start}}&ndash;{{end}}{{/isOpen}}{{^isOpen}}{{closedLabel}}{{/isOpen}}</td></tr>{{/hours}}</tbody></table>{{/hours?}}",
    "{{^note=}}<p class=\"cc-biz-note\" style=\"margin:10px 0 0 0; font-size:13px; color:#64748b;\">{{note}}</p>{{/note=}}</div>{{/hasHours}}",
    "\n{{{_script}}}</div>\n"
  ]
}
